{
  "name": "field-closeout",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate:check": "bun run src/db/migrate-check.ts",
    "db:seed": "bun run src/db/seed.ts",
    "test:unit": "bun test tests/unit",
    "test:e2e": "playwright test",
    "verify": "bun run db:migrate:check && bun run lint && bun run typecheck && bun run test:unit && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.20.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
